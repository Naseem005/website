<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Magic Playground</title>
  <style>
    body {
      font-family: 'Comic Sans MS', cursive;
      background: linear-gradient(to right, #ff9a9e, #fad0c4);
      text-align: center;
      color: #333;
    }
    header {
      background: #ff6f61;
      color: white;
      padding: 20px;
      font-size: 24px;
      border-radius: 10px;
    }
    button {
      padding: 15px 25px;
      margin: 20px;
      border: none;
      border-radius: 10px;
      background: #36a2eb;
      color: white;
      font-size: 18px;
      cursor: pointer;
      transition: transform 0.2s;
    }
    button:hover {
      transform: scale(1.1);
      background: #2e7d32;
    }
    .balloon {
      font-size: 50px;
      position: absolute;
      animation: float 5s infinite;
    }
    @keyframes float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-100px); }
      100% { transform: translateY(0); }
    }
    #surprise {
      font-size: 24px;
      margin-top: 20px;
      color: #2e7d32;
    }
  </style>
</head>
<body>
  <header>🎉 Welcome to the Magic Playground 🎉</header>

  <p>Click the buttons to play!</p>

  <button onclick="makeBalloon()">🎈 Make a Balloon</button>
  <button onclick="changeColor()">🌈 Change Background</button>
  <button onclick="showSurprise()">✨ Show Surprise</button>

  <div id="surprise"></div>

  <script>
    function makeBalloon() {
      const balloon = document.createElement("div");
      balloon.className = "balloon";
      balloon.innerText = "🎈";
      balloon.style.left = Math.random() * window.innerWidth + "px";
      balloon.style.top = Math.random() * window.innerHeight + "px";
      document.body.appendChild(balloon);
    }

    function changeColor() {
      const colors = ["#ff9a9e", "#fad0c4", "#a1c4fd", "#c2e9fb", "#fbc2eb", "#a6c0fe"];
      document.body.style.background = "linear-gradient(to right," +
        colors[Math.floor(Math.random()*colors.length)] + "," +
        colors[Math.floor(Math.random()*colors.length)] + ")";
    }

    function showSurprise() {
      const messages = ["You are awesome! 🌟", "Keep smiling 😄", "Dream big 🚀", "You’re a star ⭐"];
      document.getElementById("surprise").innerText = messages[Math.floor(Math.random()*messages.length)];
    }
  </script>
</body>
</html>
